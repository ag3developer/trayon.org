# Backend API Configuration

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trayon_backend
DB_USER=trayon
DB_PASSWORD=trayon123
DB_DIALECT=postgres

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Blockchain
L1_RPC_URL=https://polygon.drpc.org
L2_RPC_URL=http://localhost:8545
L1_CHAIN_ID=137
L2_CHAIN_ID=31337

# Contracts
TRAY_TOKEN_ADDRESS=0x424524F4012f32a8815f0cF37Eb8A3FCbF89260b
TOKENOMICS_MANAGER_ADDRESS=0x3BB78Ddb66f5De33463C1C4a69e605C526720B22
BRIDGE_L1_ADDRESS=0x6ACdf6bfA39B38441AbEBD4c1461A1a9aD8070C9
BRIDGE_L2_ADDRESS=0x5bc73652e7D866bB79989CA8E43B4F23d1b97926

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=7d

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/backend.log

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# API Keys
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
