# ════════════════════════════════════════════════════════════════════════
# Environment & Secrets
# ════════════════════════════════════════════════════════════════════════

# Environment files (contain private keys!)
.env
.env.local
.env.*.local
.env.prod
.env.test
.env.save
.env.backup

# Private keys
private_key*
*.key
*.pem
*.p12
*.pkcs12
secrets/*
!secrets/.gitkeep

# ════════════════════════════════════════════════════════════════════════
# Node.js
# ════════════════════════════════════════════════════════════════════════

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock

# ════════════════════════════════════════════════════════════════════════
# Solidity / Foundry
# ════════════════════════════════════════════════════════════════════════

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/lib/

# Hardhat
contracts/artifacts/
contracts/typechain-types/

# ════════════════════════════════════════════════════════════════════════
# IDE & Editor
# ════════════════════════════════════════════════════════════════════════

.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.prettierignore

# ════════════════════════════════════════════════════════════════════════
# OS
# ════════════════════════════════════════════════════════════════════════

.DS_Store
.AppleDouble
.LSOverride
*.bak
*.tmp
.tmp/
.cache/

# ════════════════════════════════════════════════════════════════════════
# Build & Runtime
# ════════════════════════════════════════════════════════════════════════

dist/
build/
logs/
*.log
/tmp

# ════════════════════════════════════════════════════════════════════════
# Application Specific
# ════════════════════════════════════════════════════════════════════════

# Deployment logs (may contain transaction hashes)
deployment.log
deployment-*.log

# Local blockchain data
.hardhat/
mnemonic.txt

# Relayer specific
relayer/logs/
relayer/node_modules/
relayer/dist/

# Web specific
web/node_modules/
web/.next/
web/out/
web/build/

# Testing
coverage/
.nyc_output/

# ════════════════════════════════════════════════════════════════════════
# Allowed Files (exceptions)
# ════════════════════════════════════════════════════════════════════════

# Example files are OK to commit
!.env.example
!.env.*.example
!contracts/.env.example
!relayer/.env.example

# Keep .gitkeep files
!**/.gitkeep
