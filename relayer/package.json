{
  "name": "trayon-relayer",
  "version": "1.0.0",
  "description": "Trayon Bridge Relayer - Multi-signature executor for L1/L2 transfers",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "blockchain",
    "bridge",
    "relayer",
    "multi-sig",
    "ethereum",
    "trayon"
  ],
  "author": "Trayon",
  "license": "MIT",
  "dependencies": {
    "ethers": "^6.10.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "prettier": "^3.1.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0"
  }
}
