# ════════════════════════════════════════════════════════════════════════
# TRAYON BRIDGE DEPLOYMENT CONFIGURATION
# ════════════════════════════════════════════════════════════════════════
# This file contains all configuration needed for deploying Bridge contracts
# Copy to .env and fill in your actual values
# ════════════════════════════════════════════════════════════════════════
3cfd8d9136fc147b4140cbcb1574eeeeb73fa802d9a2f168e349a73ee0e9d743

# DEPLOYMENT CREDENTIALS
# ═══════════════════════
# Private key of the account that will deploy contracts (WITHOUT 0x prefix)
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Address of the relayer manager (who can call relayer functions)
# This is usually the hot wallet/service account for the relayer
RELAYER_MANAGER_ADDRESS=0x1234567890123456789012345678901234567890

# NETWORK RPC ENDPOINTS
# ═══════════════════════
# These should match the RPC URLs in foundry.toml

# Polygon Amoy (L1) - Mumbai testnet replacement
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology

# Trayon Testnet (L2) - Your Trayon L2 node
TRAYON_TESTNET_RPC=http://localhost:8545

# OPTIONAL: PRE-EXISTING TOKEN ADDRESSES
# ════════════════════════════════════════
# If redeploying to same network, can use existing tokens
# Leave empty to deploy new tokens

# Existing TRAY token on L1 (optional)
TRAY_TOKEN_L1=

# Existing TRAY token on L2 (optional)
TRAY_TOKEN_L2=

# ETHERSCAN/BLOCK EXPLORER CONFIGURATION
# ════════════════════════════════════════
# For contract verification after deployment

# Polygon Amoy Polygonscan API key (for contract verification)
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Trayon block explorer API key (if applicable)
TRAYON_EXPLORER_API_KEY=your_trayon_api_key_here

# LOGGING AND DEBUG
# ═════════════════
# Set verbosity level for deployment output
# Options: 0 (quiet), 1 (normal), 2 (verbose), 3 (very verbose), 4 (debug)
VERBOSITY=3

# ════════════════════════════════════════════════════════════════════════
# IMPORTANT NOTES:
# ════════════════════════════════════════════════════════════════════════
# 
# 1. NEVER COMMIT THIS FILE WITH REAL PRIVATE KEYS
#    - Add .env to .gitignore
#    - Use environment variables in CI/CD
#    - Store secrets in secure vault (1Password, AWS Secrets Manager, etc)
#
# 2. CHAIN IDS:
#    - Polygon Amoy (L1): 80002
#    - Trayon Testnet (L2): 7654321
#
# 3. TESTING ACCOUNTS (Hardhat):
